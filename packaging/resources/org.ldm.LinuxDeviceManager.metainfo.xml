<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metainfo for Linux Device Manager.
     The Flatpak build renames this file (and the stock icon reference) to the
     Flatpak app-id; keep <id>, <launchable> and <icon type="stock"> in sync. -->
<component type="desktop-application">
  <id>org.ldm.LinuxDeviceManager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Linux Device Manager</name>
  <summary>View and manage hardware devices</summary>
  <description>
    <p>
      Linux Device Manager is a GTK4 application that enumerates devices
      from sysfs/udev, displays them in a category tree with detail tabs
      (general, advanced, driver, logs), and allows enabling/disabling
      devices through a privileged helper governed by polkit.
    </p>
  </description>
  <launchable type="desktop-id">linux-device-manager.desktop</launchable>
  <icon type="stock">linux-device-manager</icon>
  <categories>
    <category>System</category>
    <category>HardwareSettings</category>
  </categories>
  <url type="homepage">https://github.com/albilu/linux-device-manager</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/albilu/linux-device-manager/main/docs/wiki/images/screenshot.png</image>
      <caption>Category tree with device detail tabs</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.2.0" date="2026-09-26"/>
  </releases>
  <provides>
    <binary>linux-device-manager</binary>
  </provides>
</component>
